# === MyVault Configuration ===
# Copy this file to .env and fill in the values

# --- Database ---
# Utilise le PostgreSQL partagé d'owuicore-main (base "myvault" créée par le script init)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=myvault
POSTGRES_USER=owui
POSTGRES_PASSWORD=owui

# --- Security ---
MYVAULT_MASTER_KEY=changeme_generate_with_openssl_rand_hex_32
MYVAULT_JWT_SECRET=changeme_jwt_secret

# --- Keycloak OIDC ---
# Realm "openwebui" défini dans owuicore-main/keycloak/realm-openwebui.json
# Via le réseau Docker owui-net (keycloak est le nom du service)
OIDC_ISSUER_URL=http://keycloak:8080/realms/openwebui
OIDC_CLIENT_ID=myvault
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_ADMIN_ROLE=myvault-admin

# --- Application ---
# MYVAULT_ENVIRONMENT=production active les garde-fous de démarrage
# (refus de clé maître faible/par défaut et de DEV_MODE). Laisser "development" en local.
MYVAULT_ENVIRONMENT=development
MYVAULT_URL=http://localhost:8085
MYVAULT_BACKEND_PORT=8000
MYVAULT_LOG_LEVEL=info
MYVAULT_CORS_ORIGINS=http://localhost:8085

# --- Development ---
# DEV_MODE contourne l'authentification : ne JAMAIS l'activer hors poste local.
MYVAULT_DEV_MODE=false
MYVAULT_DEV_USER_ID=dev-user-001
MYVAULT_DEV_USER_EMAIL=dev@example.com
MYVAULT_DEV_USER_NAME=Utilisateur
MYVAULT_DEV_ADMIN=true
