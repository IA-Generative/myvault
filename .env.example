# === MyVault Configuration ===
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=myvault
POSTGRES_USER=myvault
POSTGRES_PASSWORD=changeme_db_password

# --- Security ---
MYVAULT_MASTER_KEY=changeme_generate_with_openssl_rand_hex_32
MYVAULT_JWT_SECRET=changeme_jwt_secret

# --- Keycloak OIDC ---
OIDC_ISSUER_URL=https://keycloak.example.com/realms/mirai
OIDC_CLIENT_ID=myvault
OIDC_CLIENT_SECRET=changeme_oidc_secret
OIDC_ADMIN_ROLE=myvault-admin

# --- Application ---
MYVAULT_URL=http://localhost:8080
MYVAULT_BACKEND_URL=http://localhost:8000
MYVAULT_FRONTEND_PORT=3000
MYVAULT_BACKEND_PORT=8000
MYVAULT_LOG_LEVEL=info
MYVAULT_CORS_ORIGINS=http://localhost:3000

# --- Development ---
MYVAULT_DEV_MODE=true
MYVAULT_DEV_USER_ID=dev-user-001
MYVAULT_DEV_USER_EMAIL=dev@example.com
MYVAULT_DEV_USER_NAME=Développeur Local
MYVAULT_DEV_ADMIN=true
